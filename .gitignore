# ==========================================
# TrustVault - .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend dependencies/build
frontend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
dist/
frontend/dist-ssr/
*.local

# Uploaded documents & secure storage (do NOT track user-uploaded data)
backend/storage/
storage/
uploads/
*.pdf
*.docx
*.xlsx
*.png
*.jpg
*.jpeg
*.zip

# Local database files & dumps
data/
*.db
*.sqlite3
dump/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
