APP_NAME=TrustVault
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-before-running
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=trustvault
ACCESS_TOKEN_EXPIRE_MINUTES=15
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=10
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Object Storage (Cloudflare R2 / S3-compatible persistent storage)
# Required on ephemeral hosting platforms (e.g., Render) to persist files across deploys/restarts
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trustvault-documents
R2_ENDPOINT_URL=

